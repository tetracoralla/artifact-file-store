{
  "schema": "openadam.release-profile",
  "version": "0.1",
  "distribution": {
    "source": "public",
    "audience": "public"
  },
  "carriers": [
    {
      "id": "github-release",
      "required": true
    },
    {
      "id": "npm-package",
      "required": true,
      "packages": [
        "openadam-artifact-file-store"
      ]
    },
    {
      "id": "github-actions",
      "required": true,
      "workflows": [
        "ci.yml",
        "codeql.yml",
        "release.yml"
      ]
    }
  ],
  "intentionalAbsences": []
}
